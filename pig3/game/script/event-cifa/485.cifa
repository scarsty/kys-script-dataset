battle_field_get(1, 28005, 0, 1000, 0, 0);
SetX50(1001, read_mem(1994454));
SetX50(1002, GetX50(1001) * 2);
SetX50(1002, GetX50(1002) + 146);
SetX50(1003, GetRole(GetX50(1000), GetX50(1002) / 2));
SetX50(1004, GetX50(1003) / 100);
SetX50(1100, 10);
SetX50(1101, 15);
SetX50(1102, 20);
SetX50(1103, 25);
SetX50(1104, 30);
