if (!InTeam(11)) {
    talk(34, "那就拜託少俠了", -2, 1, 0, 0);
    exit();
}
darkscene();
setscenemap(84, 1, 27, 20, 7190);
setsceneposition2(29, 21);
lightscene();
talk(11, "姐姐，姐姐！", -2, 1, 0, 0);
talk(34, "喀絲麗！真的是你，你沒事，太好了，太好了！", -2, 1, 0, 0);
talk(0, "霍姑娘，令妹安然無恙，在下總算是對得住姑娘的囑託了。", -2, 0, 0, 0);
talk(34, "少俠多次援手，青桐和族人感激不盡。今後少俠若有什麼需要，我們赴湯蹈火，在所不辭。", -2, 1, 0, 0);
talk(0, "霍姑娘言重了。只是在下近日行走江湖，多遇棘手之事，姑娘足智多謀，若能得姑娘同行，定然順利許多。只不知姑娘可肯相助在下？", -2, 0, 0, 0);
talk(34, "（清兵已然撤回，短時間內當不致再有何行動，有爹爹坐鎮，我離開一時，諒無大礙）既是少俠之請，青桐豈有推託之理？", -2, 1, 0, 0);
darkscene();
