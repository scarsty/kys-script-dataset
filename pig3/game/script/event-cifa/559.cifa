__event_559_block_2() {
        talk(0, "小師父，這是清曉師太的骨灰，你且收好了。", -2, 0, 0, 0);
        talk(0, "這是，師父……嗚嗚，多謝少俠找回我們師父的骨灰。", "尼姑", 11, 1, 0);
        talk(0, "清曉師太為救恆山派眾弟子，犧牲了自己，晚輩佩服之至。", -2, 0, 0, 0);
        talk(0, "可惜我們都武藝低微，沒法降妖除魔，替師父報仇。少俠，這把龍泉劍是我們水月庵的至寶，你請收下。希望能對你有所幫助。", "尼姑", 11, 1, 0);
        AddItem(34, 1);
        AddItemWithoutHint(232, -1);
        talk(0, "好一把鋒銳的寶劍，小師父請放心，在下一定會用這把劍，掃清妖氛，驅逐邪魔外道的。", -2, 0, 0, 0);
        SetD(63, 0, 2, 560);
    exit();
}
