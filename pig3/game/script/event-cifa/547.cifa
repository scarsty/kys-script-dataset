talk(213, "劉某自求了斷，也不須多傷人命了。", -2, 1, 0, 0);
talk(215, "君子報仇，十年未晚，走！", -2, 1, 0, 0);
darkscene();
setscenemap(32, 1, 26, 21, 8450);
lightscene();
talk(213, "曲大哥……你……", -2, 1, 0, 0);
talk(215, "不用多說！快走！", -2, 1, 0, 0);
talk(213, "小心！", -2, 1, 0, 0);
talk(215, "啊！", -2, 1, 0, 0);
talk(213, "陸柏，丁勉，你們居然背後偷襲！", -2, 1, 0, 0);
talk(215, "你還不快走！嘿!", -2, 1, 0, 0);
talk(220, "誰都別想走，啊？黑血神針，大家快退。", -2, 1, 0, 0);
talk(215, "走。", -2, 1, 0, 0);
talk(220, "追！", -2, 1, 0, 0);
