scenefromto(28, 28, 28, 22);
talk(415, "？！＜怎麼這麼多死人，看服飾他們應該是劉正風的家屬，怎麼會這樣！？劉正風手上挾持的人穿的似乎是嵩山派的服飾，難道嵩山和衡山派起了衝突？＞", -2, 0, 0, 0);
talk(221, "問這小子求不求饒？若不求饒，先割了他的鼻子，再割耳朵，再挖眼珠，叫他零零碎碎的受苦。", -2, 1, 0, 0);
talk(336, "是！你求不求饒？", -2, 1, 0, 0);
talk(213, "好孩子，你哥哥姊姊何等硬氣，死就死了，怕甚麼？", -2, 1, 0, 0);
talk(0, "可是……爹，他們要……要割我鼻子，挖……挖我眼睛……", "劉芹", 11, 1, 0);
talk(213, "哈哈，到這地步，難道你還想他們放過咱們麼？", -2, 1, 0, 0);
talk(0, "爹爹，你……你就答允殺了曲……曲伯伯……", "劉芹", 11, 1, 0);
talk(213, "放屁！小畜生，你說甚麼？", -2, 1, 0, 0);
talk(336, "小子，你再不跪下求饒，我一劍削下來了。一……二……", -2, 1, 0, 0);
talk(0, "別……別殺我……我……", "劉芹", 11, 1, 0);
talk(221, "很好，饒你不難。但你須得向天下英雄指斥劉正風的不是。", -2, 1, 0, 0);
talk(213, "小畜生，你對得起你娘麼？", -2, 1, 0, 0);
talk(0, "求求你饒了我，饒了……饒了我爹爹。", "劉芹", 11, 1, 0);
talk(221, "你爹爹勾結魔教中的惡人，你說對不對？", -2, 1, 0, 0);
talk(0, "不……不對！", "劉芹", 11, 1, 0);
talk(221, "這樣的人，該不該殺？……這小子不說話，一劍把他殺了。", -2, 1, 0, 0);
talk(336, "是！", -2, 1, 0, 0);
talk(0, "該……該殺！", "劉芹", 11, 1, 0);
talk(221, "是！", -2, 1, 0, 0);
talk(213, "姓陸的，是你贏了！", -2, 1, 0, 0);
darkscene();
