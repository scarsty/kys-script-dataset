__event_845_block_0() {
    walkfromto(29, 38, 29, 21);
    talk(34, "陳公子，趙三哥，紅花會此次仗義來援，青桐代族人謝過了。", -2, 1, 0, 0);
    talk(15, "青……霍姑娘何必如此客氣。大夥兒都是好朋友，回部有何危難，紅花會決計沒有袖手旁觀的道理。", -2, 1, 0, 0);
    talk(238, "哈哈，太好了！紅花會的英雄們本事高強，有你們相助，咱們這次一定能把那些清狗殺個落花流水！青兒你說……咦，這位小兄弟是？", -2, 1, 0, 0);
    talk(0, "在下&&，受霍姑娘之託，追回貴部失落的可蘭經，幸不辱命。", -2, 0, 0, 0);
    AddItemWithoutHint(274, -1);
    talk(34, "啊，真的是可蘭經，多謝公子！爹，咱們的經書拿回來啦。", -2, 1, 0, 0);
    talk(238, "可蘭經，可蘭經，哈哈，真是真神保佑。奉至仁慈的阿拉之名，一切讚頌，全歸阿拉，全世界的主，至仁至慈的主，報應日的君主。我們只崇拜你，只求你佑助，求你引導我們上正路，你所佑助者的路，不是受譴責者的路，也不是迷誤者的路。", -2, 1, 0, 0);
    talk(48, "恭喜木老英雄得回貴部經書……咦，&&？莫不是上次那位桃花島的&&少俠麼？", -2, 1, 0, 0);
    setsceneposition2(29, 22);
    SetRoleFace(2);
    talk(0, "正是在下，各位當家的別來無恙？", -2, 0, 0, 0);
    talk(15, "原來是你，聽說你在中原四處奔走，做下了不少大事，怎麼到了回部來？", -2, 1, 0, 0);
    talk(34, "陳公子，清軍進犯的消息，就是這位少俠帶來的，他是受了天地會陳近南陳總舵主的囑託，前來相助，和你們一般，都是我們的朋友。", -2, 1, 0, 0);
    talk(15, "是叔父讓你來帶信的？那消息應是無誤了。他老人家身子可安好麼？", -2, 1, 0, 0);
    talk(0, "陳總舵主身子康健，陳……陳公子不必擔心。（兩人都姓陳，都是總舵主，幹的又都是反清復明的事，這叔侄二人倒也有意思）對了，適才聽到各位交談，可是來相助霍姑娘與木老英雄，抗擊清兵？在下不才，亦願效犬馬之勞！", -2, 0, 0, 0);
    talk(15, "這……", -2, 1, 0, 0);
    talk(34, "那真是太好了，清軍勢大，咱們多一個人，便多了一分取勝的指望。", -2, 1, 0, 0);
    talk(15, "好罷，既然青……霍姑娘這麼說，陳某自也不能多說什麼。不過……&&少俠，當日杭州匆匆一會，別來已久，卻不知你武功進境已到何種地步，不妨在此切磋一二，對付清兵之時，大家心中也好有個底，少俠意下如何？", -2, 1, 0, 0);
    talk(0, "陳公子有此美意，自是恭敬不如從命。既然如此——", -2, 0, 0, 0);
    CallEvent(351, 4248, 3, 0, 0);
    if (GetX50(28931) != 3) {
        __event_845_block_2();
        return;
    }
    __event_845_block_1();
}
__event_845_block_1() {
    trybattle(92);
    lightscene();
    talk(0, "趙三爺果然不愧千手如來之名，諸般暗器神出鬼沒，直驚出在下一身冷汗。", -2, 0, 0, 0);
    talk(48, "呵呵，鵰蟲小技而已。小兄弟武功進步如此神速，足見天資過人，若肯在暗器上多下工夫，將來成就定在趙某之上。這是我多年來研究暗器的一點心得，就贈與少俠吧。", -2, 1, 0, 0);
    AddItem(183, 1);
    __event_845_block_2();
}
__event_845_block_2() {
    if (GetX50(28931) == 2) {
        SetRole(166, 42 / 2, 3);
        if (!TryBattle(91)) {
            SetRole(166, 42 / 2, 4);
        }
        lightscene();
        talk(0, "道長好快的劍！", -2, 0, 0, 0);
        talk(46, "哈哈，小兄弟，你的劍法可也不賴哪！這本劍譜你拿去瞧瞧，改日得閒，咱們再切磋切磋！", -2, 1, 0, 0);
        AddItem(103, 1);
    }
    if (GetX50(28931) != 1) {
        __event_845_block_8();
        return;
    }
    __event_845_block_3();
}
__event_845_block_3() {
    if (TryBattle(90)) {
        __event_845_block_6();
        return;
    }
    __event_845_block_4();
}
__event_845_block_4() {
    lightscene();
    talk(0, "陳公子武藝高明，在下甘拜下風。", -2, 0, 0, 0);
    talk(15, "呵呵，少俠武功已是大有進步，這裡有本拳譜，就贈與少俠，若能參透，必可百尺竿頭更進一步。", -2, 1, 0, 0);
    AddItem(77, 1);
    if (JudgeSexual(0)) {
        __event_845_block_8();
        return;
    }
    __event_845_block_5();
}
__event_845_block_5() {
    talk(34, "忙了這大半天，大夥兒定然都累了，青桐也不再說什麼囉嗦言語。這次與清軍交戰，我們的部署是這樣……", -2, 1, 0, 0);
    darkscene();
    lightscene();
    talk(34, "……如此如此，這般這般，各位都明白了麼？", -2, 1, 0, 0);
    talk(0, "明白！", -2, 0, 0, 0);
    talk(34, "那麼便請各位先行休息，養精蓄銳，待來日與清軍決一死戰！", -2, 1, 0, 0);
    darkscene();
    modifyevent(84, 6, 1, 0, 0, 0, 0, 7178, 7178, 7178, 0, -2, -2);
    modifyevent(84, 7, 1, 0, 0, 0, 0, 7182, 7182, 7182, 0, -2, -2);
    modifyevent(84, 8, 1, 0, 0, 0, 0, 7196, 7196, 7196, 0, -2, -2);
    modifyevent(84, 9, 1, 0, 0, 0, 0, 7186, 7186, 7186, 0, -2, -2);
    modifyevent(84, 11, 0, 0, 0, 0, 0, 0, 0, 0, 0, -2, -2);
    modifyevent(84, 5, 0, 0, 0, 0, 0, 0, 0, 0, 0, -2, -2);
    lightscene();
    exit();
}
