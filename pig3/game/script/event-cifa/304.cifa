talk(35, "你們看，你們快看！", -2, 1, 0, 0);
talk(369, "到底是什麼，快告訴我！", -2, 0, 0, 0);
talk(100, "這不是咱們家的雙鵰麼？", -2, 0, 0, 0);
talk(105, "好像受了很重的傷", -2, 0, 0, 0);
talk(104, "不知是被誰打傷的……", -2, 0, 0, 0);
talk(412, "快看，雙鵰的腳上", -2, 1, 0, 0);
talk(369, "腳上有什麼？", -2, 0, 0, 0);
talk(35, "有塊布，染著血跡……好像……好像是外公衣服上的……", -2, 1, 0, 0);
talk(369, "什麼！！", -2, 0, 0, 0);
