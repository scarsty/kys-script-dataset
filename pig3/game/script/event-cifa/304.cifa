talk(0, "柯公公早安。", -2, 1, 0, 0);
talk(369, "早。", -2, 0, 0, 0);
talk(0, "大武師兄，小武師兄，郭師姐，你們都已經來啦。", -2, 1, 0, 0);
talk(100, "當然了。自從爹娘去鎮守襄陽，我看你啊就不認真練武了，每天都遲到！", -2, 0, 0, 0);
talk(412, "我，我哪有？", -2, 1, 0, 0);
talk(105, "師父師娘去襄陽這麼久了，也沒什麼消息。", -2, 0, 0, 0);
talk(104, "是啊，連師公也出去雲遊天下，好幾年沒回桃花島了。", -2, 0, 0, 0);
talk(100, "大師公，你最疼我了。我們每天待在桃花島都快悶死了，不如帶我們一起出去玩吧？", -2, 0, 0, 0);
talk(369, "這個……", -2, 0, 0, 0);
talk(35, "啊！！！！！！", -2, 1, 0, 0);
talk(416, "是襄兒！", -2, 1, 0, 0);
talk(369, "出什麼事了？", -2, 0, 0, 0);
talk(105, "快去看看。", -2, 0, 0, 0);
darkscene();
