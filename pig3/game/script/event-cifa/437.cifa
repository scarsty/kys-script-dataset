SetX50(10, GetX50(28928) / 100);
SetX50(12, Random50(10));
if (GetX50(12) < GetX50(10)) {
    SetX50(11, GetX50(28004) + 0);
    SetX50(28004, 0);
    SetX50(13, GetRole(GetX50(28003), 82 / 2));
    SetX50(13, GetX50(13) - GetX50(11));
    if (GetX50(13) <= 0) {
        SetX50(13, 0);
    }
    SetRole(GetX50(28003), 82 / 2, GetX50(13));
}
