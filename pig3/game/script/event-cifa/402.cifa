SetX50(10, 0);
do {
    battlefieldget(1, 10, 0, 1, 0, 0);
    SetX50(3, GetRole(GetX50(1), 3));
    if (GetX50(3) == 13) {
        CallEvent(438, GetX50(1), 0, 0, 0);
    }
    SetX50(2, GetRole(GetX50(1), 13));
    if (GetX50(2) <= 0) {
        SetRole(GetX50(1), 3, 0);
        SetRole(GetX50(1), 57, 0);
        SetRole(GetX50(1), 58, 0);
        SetRole(GetX50(1), 55, 0);
        SetX50(2, 0);
    }
    SetRole(GetX50(1), 13, GetX50(2));
    SetX50(10, GetX50(10) + 1);
} while (GetX50(10) < 26);
