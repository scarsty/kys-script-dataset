scene = getcurrentscene();
y = getsceney();
x = getscenex();
evt = GetS(scene, 3, y, x);
dest = GetD(scene, evt, 7) * -1;
SetSubmapInfo(scene, 8, dest);
SetSubmapInfo(scene, 22, y);
SetSubmapInfo(scene, 23, x);
pos = GetD(scene, evt, 8);
dy = pos / 100;
dx = pos % 100;
info10 = GetSubmapInfo(scene, 10);
info11 = GetSubmapInfo(scene, 11);
if (info10 <= 0 && info11 <= 0) {
    SetSubmapInfo(dest, 24, dy);
    SetSubmapInfo(dest, 25, dx);
    exit();
}
SetSubmapInfo(dest, 14, dy);
SetSubmapInfo(dest, 15, dx);
