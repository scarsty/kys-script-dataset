SetX50(1001, getbattlecursorx());
SetX50(1002, getbattlecursory());
SetAnimationLayer(GetX50(1001), GetX50(1002), 1, 1, 1);
SetX50(1001, GetX50(1001) * 2);
SetX50(1002, GetX50(1002) * 128);
SetX50(1003, GetX50(1001) + GetX50(1002));
SetX50(1004, getbattlefieldcell(GetX50(1003)));
battlefieldget(1, 1004, 0, 1005, 0, 0);
if (GetX50(1005) >= 0) {
    battlefieldget(1, 1004, 2, 1040, 0, 0);
    battlefieldget(1, 28005, 2, 1010, 0, 0);
    if (GetX50(1040) != GetX50(1010)) {
        battlefieldget(1, 28005, 0, 1010, 0, 0);
        SetX50(1011, getbattleactor());
        SetX50(1012, GetX50(1011) * 2);
        SetX50(1012, GetX50(1012) + 146);
        SetX50(1013, GetRole(GetX50(1010), GetX50(1012) / 2));
        SetX50(1014, GetX50(1013) / 100);
        SetX50(1100, 10);
        SetX50(1101, 15);
        SetX50(1102, 20);
        SetX50(1103, 25);
        SetX50(1104, 30);
        SetX50(1105, 35);
        SetX50(1106, 40);
        SetX50(1107, 45);
        SetX50(1108, 50);
        SetX50(1109, 55);
        SetX50(1017, GetX50(1100 + GetX50(1014)));
        SetX50(1006, GetRole(GetX50(1005), 21));
        SetX50(1007, GetX50(1006) - GetX50(1017));
        if (GetX50(1007) < 0) {
            SetX50(1017, GetX50(1006) + 0);
            SetX50(1007, 0);
        }
        SetRole(GetX50(1005), 21, GetX50(1007));
        battlefieldset(5, 1004, 18, 1017, 0, 0);
    } else {
        exit();
    }
}
PlayAction(GetX50(28005), 1, 19);
ShowHurtValue(2);
Redraw();
