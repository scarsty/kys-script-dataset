            talk(0, "晚輩&&，見過婆婆，適才晚輩得聆前輩撫琴妙技，深慶晚輩身上帶著的一曲《笑傲江湖》已逢真主，便請前輩將此曲譜收下，弟子得以不負撰作此曲者的付託，完償了一番心願。", -2, 0, 0, 0);
            talk(8, "&&少俠高義，慨以妙曲見惠，老身卻之不恭，受之有愧。只不知那兩位撰曲前輩的大名，可能見告否？", "婆婆", 11, 1, 0);
            talk(0, "前輩垂詢，自當稟告。撰曲的兩位前輩，一位是劉正風劉三爺，一位是曲洋曲前輩。", -2, 0, 0, 0);
            talk(8, "啊……原來是他二人……", "婆婆", 11, 1, 0);
            talk(412, "前輩認得劉曲二位麼？", -2, 0, 0, 0);
            talk(8, "劉正風是衡山派中高手，曲洋卻是魔教長老，雙方乃是世仇，如何會合撰此曲？此中原因，令人好生難以索解。", "婆婆", 11, 1, 0);
            talk(0, "說來話長，其實是這樣的……", -2, 0, 0, 0);
