    lightscene();
    talk(415, "＜奇怪，這金輪國師的掌力大不如前了，看他也不像受了內傷，這是怎麼回事？＞", -2, 0, 0, 0);
    talk(251, "小子，算你厲害，老衲勝你不得，還不快滾。", -2, 1, 0, 0);
    talk(424, "＜之前聽襄兒說，國師有意收她為徒，看來他也是不忍真的傷害襄兒＞國師，多謝了。", -2, 0, 0, 0);
