    talk(421, "啊……那……是師妹！", -2, 0, 0, 0);
    talk(2, "襄兒！", -2, 1, 0, 0);
    talk(251, "小郭襄，快叫你父投降，我從一數到十，你父親不降，我便下令舉火了。", -2, 0, 0, 0);
    talk(35, "你愛數便數，別說從一數到十，你且數到一千、一萬試試。", -2, 1, 0, 0);
    talk(251, "你道我當真不敢燒死你嗎？", -2, 0, 0, 0);
    talk(35, "我只覺得你挺可憐的。", -2, 1, 0, 0);
    talk(251, "我可憐什麼？", -2, 0, 0, 0);
    talk(35, "你不敢和我爹爹、&&師兄正面交鋒，只有本事把我綁在這裡。我襄陽城中，便是一個帳前小卒，也不至於似你這般卑鄙無恥。喂，你一直待我不錯，我本該叫你師父，但我見你胡里胡塗，心中過意不去，忍不住要勸你一句。", -2, 1, 0, 0);
    talk(251, "你勸我什麼？", -2, 0, 0, 0);
    talk(35, "如你這般為人，大和尚，你武功再高，卻沒有一點大宗師的氣度和風範，你活在世上有何意味？不如跳入火堆，圖個自盡罷！", -2, 1, 0, 0);
    talk(251, "你……！我不跟你這小姑娘一般見識。郭靖聽著！我從一數到十，你如不歸降，我便下令舉火燒臺。", -2, 0, 0, 0);
    talk(1, "你看我郭靖是投降之人麼？", -2, 1, 0, 0);
    talk(416, "金輪國師，你料敵不明，是為不智；欺侮弱女，是為不仁；不敢與我們真刀真槍決勝，是為不勇。如此不智不仁不勇之人，還充什麼英雄好漢？還有臉面身居蒙古第一國師之位麼？", -2, 0, 0, 0);
    talk(251, "臭小子，這裡哪有你說話的份！郭靖，你聽著，我從一數到十，十字出口，你的愛女便成焦炭。一……二……三……四……", -2, 1, 0, 0);
    talk(251, "五，六、七……七……（望著郭襄）", -2, 0, 0, 0);
    talk(363, "國師，你怎麼了？都這時候了，八……九……十！好，舉火！", -2, 1, 0, 0);
    talk(0, "全體將士聽命，一定要拿下襄陽城。", "蒙哥", 0, 1, 0);
    talk(362, "大汗！大汗！！大汗！！！", -2, 1, 0, 0);
    talk(1, "蒙哥居然親自攻城，救女事小，守城事大！諸位英雄，咱們別管襄兒，急速回襲敵軍後方。", -2, 0, 0, 0);
    talk(416, "不，我要去救襄兒。", -2, 1, 0, 0);
    talk(1, "&&，回來。", -2, 0, 0, 0);
