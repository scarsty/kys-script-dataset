walkfromto(37, 25, 30, 25);
talk(0, "師父，這次總算是幸不辱命。", -2, 0, 0, 0);
talk(1, "&&，各派高手已於前幾日陸續趕到了，這次有這麼多英雄豪傑匯聚襄陽，一定能擋住蒙古軍的鐵蹄。你可真是功不可沒啊。", -2, 1, 0, 0);
talk(0, "呵呵，謝師父誇獎。", -2, 0, 0, 0);
talk(1, "我和你師娘正在商議如何調配人手，你也一起出出主意吧。", -2, 1, 0, 0);
talk(0, "師娘神機妙算，有您運籌帷幄，我跑跑腿就行了。", -2, 0, 0, 0);
talk(2, "別耍貧嘴了，明日蒙古大軍將會三面進攻，我已經安排了全真教和丐幫守西門、少林派和青城派守南門、武當派和水莊主等人守北門，五嶽劍派負責…………………………………………………………", -2, 1, 0, 0);
darkscene();
lightscene();
talk(424, "ZZZZZZZZZZZZZZZ", -2, 0, 0, 0);
talk(2, "&&", -2, 1, 0, 0);
talk(413, "在，我在聽，我真的在聽（汗）", -2, 0, 0, 0);
talk(2, "行了，沒說你不在聽，現在該說你的任務了。", -2, 1, 0, 0);
talk(0, "恩，但憑師娘差遣。", -2, 0, 0, 0);
talk(2, "你輕功的底子好，又曾負責聯絡各方英雄，對於各派的實力多少有些瞭解，現在就派你負責照應全局，哪一方有危險，你就速速前去救援。", -2, 1, 0, 0);
talk(413, "是（暈，我還真的是跑腿的）", -2, 0, 0, 0);
talk(1, "早些休息吧，明天可是要打一場硬仗。", -2, 1, 0, 0);
