__event_1355_block_0() {
    talk(79, "欲將心事付瑤琴，知音少，絃斷有誰聽……唉……", -2, 0, 0, 0);
    talk(0, "請問先生為何在此嘆息？", -2, 1, 0, 0);
    talk(79, "我只是慨嘆古之伯牙與子期，一曲高山流水，得遇知音，鍾子期病逝之後，伯牙甘願斷琴，再不奏曲。枉我此生好琴，卻無知音可賞，縱然琴技再好，又有何用？豈不可惜可嘆！", -2, 0, 0, 0);
    talk(0, "這……先生又怎知這世間沒有知音呢？在下不才，於琴藝知之甚少，卻相信世間一定有人可以懂先生的琴聲。", -2, 1, 0, 0);
    talk(79, "此言差矣，琴藝高超只能聽出奏琴者的技藝高低，而要懂得曲中之意卻唯有用心去聽，與琴藝高下無關。", -2, 0, 0, 0);
    talk(412, "用心？", -2, 1, 0, 0);
    talk(79, "不錯。我現在就彈奏幾曲，你可以用心感受一下，曲中表現了什麼情景？", -2, 0, 0, 0);
    CallEvent(251, 0, 0, 0, 0);
    if (GetX50(28929) == 1) {
        __event_1355_block_2();
        return;
    }
    __event_1355_block_1();
}
__event_1355_block_1() {
    talk(79, "唉……當路誰當假，知音世所稀，真是一點都不假……", -2, 0, 0, 0);
    talk(0, "先生請見諒，晚輩確實不通此道。", -2, 1, 0, 0);
    modifyevent(68, 15, 1, 0, 1356, 0, 0, 7052, 7052, 7052, 0, -2, -2);
    exit();
    __event_1355_block_2();
}
__event_1355_block_2() {
        talk(79, "少俠果然有慧根，看來這世間還是有人能解我的琴聲，甚善……", -2, 0, 0, 0);
        talk(0, "先生過獎，我也有幾個長於音律的朋友，不知您可願隨我回歸雲莊，與他們共同參詳這本曲譜，再譜當世絕響？", -2, 1, 0, 0);
        talk(79, "少俠如此好意邀請，我又怎能推辭。這“冰蠶絲”是我尋來做琴絃剩下的，是罕有的柔韌之物，送與少俠，或許日後有用。", -2, 0, 0, 0);
        darkscene();
        modifyevent(68, 15, 0, 0, 0, 0, 0, 0, 0, 0, 0, -2, -2);
        lightscene();
        SetStarState(76, 2);
        ShowTeammate(76, 79, 0);
        modifyevent(16, 62, 1, 0, 776, 0, 0, 7050, 7050, 7050, 0, -2, -2);
        AddItem(245, 1);
    exit();
}
__event_1355_block_0();
