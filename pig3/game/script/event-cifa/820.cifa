__event_820_block_8() {
    talk(0, "好你個重色輕友段正笛，每次演練陣法你都不來，這下好了吧。還有齊小白，每次練著練著就睡過去了……", "五毒使丙", 11, 1, 0);
    talk(124, "你們幾個，還有臉在這相互埋怨，連個小毛孩子都收拾不了，還說這個五毒陣是你們傳教之寶，哼哼……", -2, 1, 0, 0);
    talk(0, "（小聲）教主不是也拿他們沒辦法麼，不然也用不著這麼遠把我們從雲南調來，害我沒得約會……", "五毒使乙", 11, 1, 0);
    talk(123, "段正笛，你嘀咕什麼呢？", -2, 1, 0, 0);
    talk(125, "大敵當前，師弟你就少說幾句，再說師父在此，有他主持大局，還輪不到你來說什麼", -2, 1, 0, 0);
    talk(124, "大師兄說得是。", -2, 1, 0, 0);
    talk(123, "哼！", -2, 1, 0, 0);
    talk(85, "呦～乖弟弟，怎麼又是你？難不成是上次見了姐姐我之後念念不忘，一路跟來的？", -2, 1, 0, 0);
    talk(423, "（臉紅）（怎麼又是她……）何…何教主，自上次南少林一役後，貴教藍教主已經決定不再為石萬嗔所利用，天地會陳總舵主也許你們苗人以自治權，我也可以保證你從此之後不受石萬嗔乃至日月神教侵擾……", -2, 0, 0, 0);
    talk(85, "呦～乖弟弟，你保證？怎麼保證？要整天跟在姐姐我身邊兒麼？", -2, 1, 0, 0);
    talk(412, "我……", -2, 0, 0, 0);
    talk(129, "何鐵手！你哪來這麼多廢話，今天就要把這小子立斃於此，永絕後患！五毒使，列陣！慕容景岳，姜鐵山，薛鵲，你們三人分別助五毒使掌陣！", -2, 1, 0, 0);
    if (TryBattle(80)) {
        __event_820_block_10();
        return;
    }
    __event_820_block_9();
}
