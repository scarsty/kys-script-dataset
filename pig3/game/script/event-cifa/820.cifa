__event_820_block_0() {
    talk(0, "終於到南關了，過去這裡便是中原，更遠的路在等著我們。", -2, 0, 0, 0);
    walkfromto(44, 32, 35, 32);
    scenefromto(35, 32, 25, 32);
    scenefromto(25, 32, 35, 32);
    talk(415, "（想不到那石老兒竟然還牢牢控制著五毒教，看來想通過南關，今日還要費一番周折）對面的聽著，你們的藍教主已經擺脫了石老兒的控制，你們還不速速放關，再跟著你們藍教主回苗疆去吧，不要再受那石老兒擺佈了。", -2, 0, 0, 0);
    talk(350, "哪來的小子在這胡說八道，弟兄們，教訓教訓他", -2, 1, 0, 0);
    if (TryBattle(78)) {
        __event_820_block_2();
        return;
    }
    __event_820_block_1();
}
