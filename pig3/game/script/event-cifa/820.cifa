__event_820_block_4() {
    talk(350, "小子休要猖狂，藍教主一時不慎被你等所擒，現下本教神奇無敵五毒使已從雲南趕來，等下有你們好瞧的。", -2, 1, 0, 0);
    talk(415, "（神奇無敵五毒使？聽起來好像很猛的樣子……）", -2, 0, 0, 0);
    talk(350, "小子，本教五毒使駕到，你現在想跑都遲了。", -2, 1, 0, 0);
    talk(0, "偶是水毒使齊桓公，姓齊名桓公字小白，長老齊雲傲是偶侄子。", "五毒使甲", 11, 1, 0);
    talk(0, "俺是金毒使段正笛，大理人士，段正淳是俺堂哥。", "五毒使乙", 11, 1, 0);
    talk(0, "吾乃土毒使曹長功，專職工作是鞭策齊桓公，業餘工作是鄙視段正笛。", "五毒使丙", 11, 1, 0);
    talk(0, "我是火毒使鵲輪上人，金輪法王和大輪明王的師弟", "五毒使丁", 11, 1, 0);
    talk(0, "余乃木毒使月小白，跟齊桓公比不知道誰更白，我們倆合起來叫小白TWO。", "五毒使戊", 11, 1, 0);
    talk(415, "（這什麼亂七八糟的……我沒來錯地方吧）", -2, 0, 0, 0);
    talk(0, "接我們的五毒大陣吧！", "五毒使甲", 11, 1, 0);
    if (TryBattle(79)) {
        __event_820_block_6();
        return;
    }
    __event_820_block_5();
}
