__event_1620_block_0() {
    talk(176, "阿彌陀佛～", -2, 0, 0, 0);
    talk(412, "智光大師，您怎麼在這裡？", -2, 1, 0, 0);
    talk(176, "施主可看到這崖壁了嗎？", -2, 0, 0, 0);
    talk(415, "這崖壁……好像被刮去了一層？", -2, 1, 0, 0);
    talk(176, "不錯，這正是當年喬幫主的父親留書之所。壁上的文字早已被人抹去，不過我曾經拓印過壁上文字，現在已經交給了喬幫主。", -2, 0, 0, 0);
    talk(0, "那喬大哥他現在……", -2, 1, 0, 0);
    talk(176, "我不知道他在哪裡，不過他應該在尋找帶頭大哥的消息吧。唉，冤冤相報何時了。施主與喬幫主交好，希望施主可以勸導喬幫主，以天下蒼生為念，切勿濫殺無辜。", -2, 0, 0, 0);
    talk(0, "多謝大師教誨，我想喬大哥不是那樣的人。", -2, 1, 0, 0);
    talk(176, "阿彌陀佛，這本刀譜贈與施主，希望能對施主的大業有所幫助。", -2, 0, 0, 0);
    talk(0, "多謝大師。", -2, 1, 0, 0);
    talk(176, "慈悲，慈悲啊……", -2, 0, 0, 0);
    darkscene();
    modifyevent(57, 66, 0, 0, 0, 0, 0, 0, 0, 0, 0, -2, -2);
    lightscene();
    AddItem(127, 1);
    SetX50(0, GetRole(166, 40 / 2));
    if (GetX50(0) == 0) {
        __event_1620_block_2();
        return;
    }
    __event_1620_block_1();
}
