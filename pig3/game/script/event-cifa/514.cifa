__event_514_block_0() {
    scenefromto(43, 31, 31, 31);
    talk(118, "他媽的，點子扎手，大哥二哥三哥，扯呼~~~", -2, 0, 0, 0);
    talk(358, "哪裡跑！你們幾個上次騙我們丟了鏢，這次不宰了你們，難消心頭之氣！", -2, 1, 0, 0);
    talk(117, "啊喲，好疼！二哥，你怎樣？", -2, 0, 0, 0);
    talk(425, "……怎麼又是他們幾個= = ", -2, 0, 0, 0);
    talk(115, "跑不及了，兄弟們，出最後一招！", -2, 0, 0, 0);
    talk(116, "救——命——啊——", "太嶽四俠", 1, 0, 0);
    talk(425, "（冒冷汗）別喊了！", -2, 0, 0, 0);
    talk(118, "&&少俠，是你？", -2, 0, 0, 0);
    if (TryBattle(15)) {
        __event_514_block_2();
        return;
    }
    __event_514_block_1();
}
__event_514_block_1() {
    dead();
    exit();
    __event_514_block_2();
}
__event_514_block_2() {
        lightscene();
        talk(358, "媽呀——", -2, 1, 0, 0);
        darkscene();
        setscenemap(17, 1, 31, 30, 0);
        setscenemap(17, 1, 31, 31, 0);
        setscenemap(17, 1, 31, 32, 0);
        setscenemap(17, 1, 31, 33, 0);
        setsceneposition2(31, 31);
        lightscene();
        talk(415, "你們幾個，怎麼又在這裡打劫？", -2, 0, 0, 0);
        talk(117, "少俠，這群鏢師，是上次敗在我們手下那鏢局子的，我們，我們是覺得空著雙手上晉陽，實在不好意思……", -2, 1, 0, 0);
        talk(414, "哦～所以你們覺得軟柿子好捏，沒想到人家非但不跑了，還殺了回來？", -2, 0, 0, 0);
        talk(116, "這堆龜孫子，不知吃了什麼靈藥，功夫長進這麼快", -2, 1, 0, 0);
        talk(115, "唔，他們長進雖快，卻還是不敵少俠武功高強。三位兄弟，我有個打算", -2, 1, 0, 0);
        talk(117, "大哥，什麼打算？", -2, 1, 0, 0);
        talk(115, "咱們兩次劫奪壽禮，都不甚順利，想來定然是老天註定，咱們不宜賀壽，這晉陽，還是不去了", -2, 1, 0, 0);
        talk(118, "大哥料事如神，言之有理，那麼咱們現下做什麼？", -2, 1, 0, 0);
        talk(115, "這位少俠武功高強，宅心仁厚，可惜江湖經驗淺了些，咱們不如與他結伴而行，一路照拂，總不能不讓他吃了虧去", -2, 1, 0, 0);
        talk(118, "大哥料事如神，言之有理……", -2, 1, 0, 0);
        talk(425, "￥%￥￥%@@#%……", -2, 0, 0, 0);
        darkscene();
        setscenemap(17, 1, 29, 30, 0);
        setscenemap(17, 1, 29, 31, 0);
        setscenemap(17, 1, 29, 32, 0);
        setscenemap(17, 1, 29, 33, 0);
        lightscene();
        SetStarState(107, 2);
