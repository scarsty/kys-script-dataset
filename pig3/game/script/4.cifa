f18() {
    i = 1;
    while (1) {
        talk(readtalkasstring(i));
        if (i<2) {
            talk(inteam(0));
            else if (i < 4) {
                talk("medium");
            }
            else {
                talk("big");
            }
            i = i + 1;
            if (i > 5) {
                break;
            }
        }
    }
    f19() {
        showstringwithbox(10, 10, "請選擇材料");
        a=menu(3, 10, 40, 100, {"靖鐵","沖金","雲石"});
        if (a==-1) {
            exit();
        }
        else {
            b=a+211;
            c=haveitem(b);
            if (c==0) {
                talk(86, "你沒有該材料。", -2, 0, 0, 0);
                exit();
            }
            else {
                showstringwithbox(10, 10, "請選擇花草");
                z=menu(6, 10, 40, 100, {"芙蓉","紫薇","霜菊","嫣茶","芷蘭","盈竹"});
                if (z==-1) {
                    exit();
                }
                else {
                    y=z+214;
                    x=haveitem(y);
                    if (x==0) {
                        talk(86, "你沒有該花草。", -2, 0, 0, 0);
                        d=getnameasstring(1,b);
                        showstringwithbox(10, 10, "現在只有" + to_string(d)"這種材料，是否製作？");
                        f=menu(2, 10, 40, 100, {"是","否"});
                        if (f!=0) {
                            exit();
                        }
                    }
                    else {
                        AddItemWithoutHint(b,-1);
                        AddItemWithoutHint(y,-1);
                        g=getitempro(b,42);
                        h=getitempro(y,42);
                        i=g+h;
                        j=187;
                        while (j<203) {
                            j=j+1;
                            k=getitempro(j,42);
                            if (k==i) {
                                AddItem(j,50);
                                exit();
                            }
                        }
                        AddItem(205,1);
                    }
                }
            }
        }
        exit();
    }
    f20() {
        setitemintro(0, "一张藏宝图，好像已经被撕毁");
    }
