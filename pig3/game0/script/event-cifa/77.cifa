talk(0, "＜哇！這裡戒備森嚴，如臨大敵似的，我可得小心一點．＞小弟遠從中原來到這西域，請問這裡就是明教吧？", 0, 1);
talk(80, "從中原來的？想必是六大派的爪牙．竟敢如此大搖大擺走進來，莫非欺我明教無能人？", 80, 0);
talk(0, "我．．．．．．", 0, 1);
talk(80, "先拿下再說！", 80, 0);
if (!TryBattle(8)) {
    dead();
} else {
    modifyevent(-2, 1, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
    modifyevent(-2, 2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
    modifyevent(-2, 3, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
    lightscene();
    addrepute(2);
}
