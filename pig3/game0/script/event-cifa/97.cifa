talk(17, "少俠如果有需要的話，儘管說出來．", 17, 0);
if (AskJoin()) {
    talk(0, "好吧！那就麻煩王前輩與我一起奔波江湖了．", 0, 1);
    if (!TeamIsFull()) {
        darkscene();
        modifyevent(-2, -2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        lightscene();
        join(17);
        addethics(1);
    } else {
        talk(17, "你的隊伍已滿，我無法加入．", 17, 0);
    }
} else {
    talk(0, "改日如果有需要時，我一定會來找王前輩．", 0, 1);
}
