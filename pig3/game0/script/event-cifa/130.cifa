talk(8, "不知少俠來我崆峒山有何貴事？", 8, 0);
if (AskBattle()) {
    talk(0, "我想找你練練功，賺些經驗點數．", 0, 1);
    talk(8, "哼！那就來吧．", 8, 0);
    if (TryBattle(17)) {
        lightscene();
        talk(0, "嗯，這經驗點數還真好賺．", 0, 1);
        addethics(-1);
    } else {
        dead();
    }
} else {
    talk(0, "我是來叮嚀你的，以後要跟明教和平相處哦！不要再互相殘殺了．", 0, 1);
    talk(8, "哼！", 8, 0);
}
