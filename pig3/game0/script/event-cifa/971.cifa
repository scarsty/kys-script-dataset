talk(37, "公子別來無恙？", 37, 0);
if (AskJoin()) {
    talk(0, "我這次來是找狄兄幫忙的．", 0, 1);
    if (!TeamIsFull()) {
        talk(37, "狄某欠公子一個人情，公子需要幫忙，狄某自當義不容辭．", 37, 0);
        darkscene();
        modifyevent(-2, 7, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        modifyevent(-2, 8, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        modifyevent(-2, 10, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(37);
    } else {
        talk(37, "你的隊伍已滿，我無法加入．", 37, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
