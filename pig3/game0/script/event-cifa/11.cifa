talk(1, "有什麼要我幫忙的，儘管說出來．", 1, 0);
if (AskJoin()) {
    talk(0, "胡大哥肯隨我闖盪江湖否？", 0, 1);
    if (!TeamIsFull()) {
        talk(1, "好．我就隨你一走．", 1, 0);
        talk(0, "胡大哥肯隨我闖盪江湖幫這個忙，那再好也不過了．", 0, 1);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(1);
        addethics(1);
    } else {
        talk(1, "你的隊伍已滿，我無法加入．", 1, 0);
    }
}
