talk(36, "公子別來無恙？", 36, 0);
if (AskJoin()) {
    talk(0, "不知林公子是否還有意與我為伴，一同行走江湖．", 0, 1);
    if (!TeamIsFull()) {
        talk(36, "好啊．", 36, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(36);
    } else {
        talk(36, "你的隊伍已滿，我無法加入．", 36, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
