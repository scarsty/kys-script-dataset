talk(51, "怎麼？想通了．", 51, 0);
if (AskJoin()) {
    talk(0, "好，就聽你的．", 0, 1);
    if (!TeamIsFull()) {
        talk(51, "走．", 51, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(51);
    } else {
        talk(51, "你的隊伍已滿，我無法加入．", 51, 0);
    }
} else {
    talk(0, "不行，我不能這麼做．", 0, 1);
}
