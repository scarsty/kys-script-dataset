talk(9, "你能帶我去找義父嗎？", 9, 0);
if (AskJoin()) {
    talk(0, "好啊，我就帶你去找他．", 0, 1);
    if (!TeamIsFull()) {
        talk(9, "謝謝這位大哥．", 9, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(9);
        addethics(2);
    } else {
        talk(9, "你的隊伍已滿，我無法加入．", 9, 0);
    }
} else {
    talk(0, "這恐怕不行，我還有許多要事在身，無法帶你去找他．", 0, 1);
    talk(9, "．．．．．", 9, 0);
}
