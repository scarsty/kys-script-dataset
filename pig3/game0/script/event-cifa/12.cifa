talk(0, "胡大哥，我知道苗人鳳的下落，而關於你們之間的恩怨是如此如此這般這般．．．", 0, 1);
if (AskJoin()) {
    talk(0, "胡大哥是否肯隨我一走？", 0, 1);
    if (!TeamIsFull()) {
        talk(1, "好．我就隨你一走．", 1, 0);
        talk(0, "胡大哥肯隨我一走，那再好也不過了．", 0, 1);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(1);
        addethics(1);
    } else {
        talk(1, "你的隊伍已滿，我無法加入．", 1, 0);
    }
}
