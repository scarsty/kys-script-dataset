talk(63, "公子近來無恙？", 63, 0);
if (AskJoin()) {
    talk(0, "還好，不過有程姑娘在隊中會更好．", 0, 1);
    if (!TeamIsFull()) {
        talk(63, "好吧，我就再陪你走一遭．", 63, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(63);
    } else {
        talk(63, "你的隊伍已滿，我無法加入．", 63, 0);
    }
} else {
    talk(0, "托程姑娘的福，一切還好．", 0, 1);
}
