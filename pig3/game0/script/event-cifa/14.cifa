talk(38, "我要去找媽媽跟小黃．", 38, 0);
if (AskJoin()) {
    talk(0, "你要找你媽媽？我正好在四處旅行，不妨我們結伴一起走，好嗎？", 0, 1);
    if (!TeamIsFull()) {
        talk(38, "好啊！", 38, 0);
        darkscene();
        modifyevent(-2, 7, 0, 0, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        modifyevent(-2, 8, 0, 0, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(38);
        addethics(1);
    } else {
        talk(38, "你的隊伍已滿，我無法加入．", 38, 0);
    }
}
