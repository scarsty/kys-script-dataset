talk(65, "真希望瑛姑趕快來殺我，解除我的罪孽．", 65, 0);
if (AskBattle()) {
    addethics(-1);
    if (!TryBattle(68)) {
        lightscene();
        talk(65, "閣下還是回去請瑛姑親自來動手吧，我會在這等她的．", 65, 0);
    } else {
        modifyevent(21, 1, -2, -2, 420, -1, -1, -2, -2, -2, -2, -2, -2);
        modifyevent(-2, -2, -2, -2, -1, -1, -1, 6226, 6226, 6226, -2, -2, -2);
        lightscene();
        addethics(-10);
        addrepute(10);
    }
} else {
    talk(0, "．．．．", 0, 1);
}
