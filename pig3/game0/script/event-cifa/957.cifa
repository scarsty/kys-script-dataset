talk(16, "少俠別來無恙？", 16, 0);
if (AskJoin()) {
    talk(0, "少了胡先生的奇妙醫術，一路上難免病痛煩身，是否可以再請胡先生幫忙呢？", 0, 1);
    if (!TeamIsFull()) {
        talk(16, "少俠有求，胡某自當效力．", 16, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(16);
    } else {
        talk(16, "你的隊伍已滿，我無法加入．", 16, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
