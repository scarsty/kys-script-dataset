talk(1, "兄弟別來無恙？", 1, 0);
if (AskJoin()) {
    talk(0, "少了大哥胡家刀法助威，小弟辦起事來總覺得不順，．．．", 0, 1);
    if (!TeamIsFull()) {
        talk(1, "別說了，我就再助你一臂之力．", 1, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(1);
    } else {
        talk(1, "你的隊伍已滿，我無法加入．", 1, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
