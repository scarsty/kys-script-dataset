if (InTeam(47)) {
    talk(48, "阿紫姑娘，你別丟下我一個人．**求求少俠讓我加入，好讓我跟在阿紫姑娘身旁服侍她．", 48, 0);
    if (AskJoin()) {
        talk(0, "也好．", 0, 1);
        if (!TeamIsFull()) {
            darkscene();
            modifyevent(-2, 4, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
            lightscene();
            join(48);
            addethics(-2);
        } else {
            talk(48, "你的隊伍已滿，我無法加入．", 48, 0);
        }
    }
} else {
    talk(48, "你別在這惹阿紫姑娘生氣．", 48, 0);
}
