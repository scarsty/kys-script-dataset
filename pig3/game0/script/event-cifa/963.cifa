talk(28, "有什麼事嗎？", 28, 0);
if (AskJoin()) {
    talk(0, "這次來是要您再隨我一走，隊伍中需要大夫．", 0, 1);
    if (!TeamIsFull()) {
        talk(28, "走吧．", 28, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(28);
    } else {
        talk(28, "你的隊伍已滿，我無法加入．", 28, 0);
    }
} else {
    talk(0, "沒事沒事．", 0, 1);
}
