talk(49, "施主別來無恙？", 49, 0);
if (AskJoin()) {
    talk(0, "小師父，我有麻煩了，快幫幫我．", 0, 1);
    if (!TeamIsFull()) {
        talk(49, "阿彌陀佛！施主有難，小僧自當效力．", 49, 0);
        darkscene();
        modifyevent(-2, 2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        modifyevent(-2, 15, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(49);
    } else {
        talk(49, "你的隊伍已滿，我無法加入．", 49, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
