talk(45, "公子別來無恙？", 45, 0);
if (AskJoin()) {
    talk(0, "少了薛先生的奇妙醫術，一路上難免病痛煩身，是否可以再請薛先生幫忙呢？", 0, 1);
    if (!TeamIsFull()) {
        talk(45, "公子有需，薛某自當效力．", 45, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(45);
    } else {
        talk(45, "你的隊伍已滿，我無法加入．", 45, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
