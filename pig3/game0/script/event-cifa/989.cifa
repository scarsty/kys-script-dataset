talk(54, "小兄弟，最近還好嗎？", 54, 0);
if (AskJoin()) {
    talk(0, "不瞞袁兄，最近諸事不順．．．．．．．", 0, 1);
    if (!TeamIsFull()) {
        talk(54, "別說了，我們走吧．", 54, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(54);
    } else {
        talk(54, "你的隊伍已滿，我無法加入．", 54, 0);
    }
} else {
    talk(0, "托袁兄的福，一切還好．", 0, 1);
}
