if (HaveItem(110)) {
    talk(0, "袁兄，我找到金蛇山洞了，而且將金蛇劍給拔了出來．我已經通過了前兩道考驗．", 0, 1);
    talk(54, "很好，接下來讓我看看你在江湖上的表現．", 54, 0);
    if (!JudgeEthics(0, 80, 100)) {
        talk(54, "可惜呀可惜．雖然有了智慧和勇氣，但是”仁義”方面還要加強．", 54, 0);
        modifyevent(-2, -2, -2, -2, 637, -1, -1, -2, -2, -2, -2, -2, -2);
        if (AskBattle()) {
            talk(0, "袁兄，我沒什麼時間去增加”仁義”點數了，只好得罪了．", 0, 1);
            if (TryBattle(101)) {
                modifyevent(-2, -2, -2, -2, 639, -1, -1, -2, -2, -2, -2, -2, -2);
                lightscene();
                talk(54, "唉！你又往邪道走近一步，武功這麼好，為什麼不用在正途上呢？", 54, 0);
                AddItem(156, 1);
                addrepute(2);
            } else {
                modifyevent(-2, -2, -2, -2, 637, -1, -1, -2, -2, -2, -2, -2, -2);
                lightscene();
                talk(54, "我還是勸你多做些俠義之事才是．", 54, 0);
            }
        }
    } else {
        talk(54, "很好，你在江湖中行走這麼久，還能保持在正道上，很好．”碧血劍”一書就拿去吧．", 54, 0);
        AddItem(156, 1);
        modifyevent(-2, -2, -2, -2, 638, -1, -1, -2, -2, -2, -2, -2, -2);
    }
} else {
    talk(54, "完成前兩道考驗後，再回來浡泥島上．", 54, 0);
}
