talk(29, "兄弟，一路上還爽吧？又搞了幾個女人呀？", 29, 0);
if (AskJoin()) {
    talk(0, "沒有你同行，小弟一人怎麼玩得起來．", 0, 1);
    if (!TeamIsFull()) {
        talk(29, "那就走吧．我一個人玩也沒什麼意思，團體的比較好玩．", 29, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(29);
    } else {
        talk(29, "你的隊伍已滿，我無法加入．", 29, 0);
    }
} else {
    talk(0, "田兄真愛開玩笑．", 0, 1);
}
