talk(9, "公子別來無恙？", 9, 0);
if (AskJoin()) {
    talk(0, "少了張兄的九陽神功，一路上頗多兇險，是否可以再請張兄出馬？", 0, 1);
    if (!TeamIsFull()) {
        talk(9, "好的．", 9, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(9);
    } else {
        talk(9, "你的隊伍已滿，我無法加入．", 9, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
