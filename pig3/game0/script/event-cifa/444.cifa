talk(0, "這位兄台，你家怎麼有這麼多漂亮姊姊．", 0, 1);
talk(61, "她們都是我的弟子．", 61, 0);
talk(0, "你這師父是教什麼武功，怎麼都收女弟子．難不成你這兒是”妹登風”嗎？", 0, 1);
talk(61, "什麼是”妹登風”？我這裡是白駝山．我是這裡的少主歐陽克，我的弟子都是從各地挑選出的美女，由我親自傳授”床上功夫”．", 61, 0);
talk(0, "＜這是限制級的遊戲嗎？＞你吃的消嗎？分我幾個好了．", 0, 1);
talk(61, "你是誰，到我白駝山撒野．要比床上功夫前先來比一比真武藝．", 61, 0);
if (TryBattle(69)) {
    lightscene();
    talk(0, "怎樣，我的功夫比你強吧．", 0, 1);
    talk(61, "你知道我是誰嗎．", 61, 0);
    talk(0, "你不是說了嗎，你是白駝山的少主．", 0, 1);
    talk(61, "那你不知道我叔父是誰嗎？", 61, 0);
    talk(0, "是誰？", 0, 1);
    talk(61, "江湖上人稱”西毒”的歐陽鋒．", 61, 0);
    talk(0, "聽起來好像不好惹．", 0, 1);
    talk(61, "知道不好惹就對了．小子，我看你功夫還不錯，這樣子好了，我們可以找一些志同道合的人，使盡各種手段，打倒各大門派，稱霸這武林．到時我們就可和我叔父他們一般，闖出一番名號，讓武林中人聞之喪膽．", 61, 0);
    talk(0, "你說要不惜使用各種手段，那行為不是太卑鄙了嗎？", 0, 1);
    talk(61, "這年頭你還想正正當當的？那你要等到什麼時後才能稱霸武林．", 61, 0);
    talk(0, "我想看看．．．．", 0, 1);
    addrepute(1);
    modifyevent(-2, -2, -2, -2, 445, -1, -1, -2, -2, -2, -2, -2, -2);
    modifyevent(-2, 7, -2, -2, -1, -1, 473, -2, -2, -2, -2, -2, -2);
    modifyevent(-2, 8, -2, -2, -1, -1, 473, -2, -2, -2, -2, -2, -2);
    if (AskJoin()) {
        talk(0, "好吧，那我們就一起稱霸武林吧．反正有句名言不是說”好人早死，壞人較長命”", 0, 1);
        if (JudgeFemaleInTeam()) {
            if (!TeamIsFull()) {
                talk(61, "走吧，再去找一些邪惡的人來加入．", 61, 0);
                darkscene();
                modifyevent(-2, 0, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
                modifyevent(-2, 1, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
                modifyevent(-2, 2, -2, -2, 472, -1, -1, -2, -2, -2, -2, -2, -2);
                modifyevent(-2, 3, -2, -2, 472, -1, -1, -2, -2, -2, -2, -2, -2);
                modifyevent(-2, 4, -2, -2, 472, -1, -1, -2, -2, -2, -2, -2, -2);
                modifyevent(-2, 5, -2, -2, 472, -1, -1, -2, -2, -2, -2, -2, -2);
                modifyevent(-2, 6, -2, -2, 472, -1, -1, -2, -2, -2, -2, -2, -2);
                modifyevent(-2, 7, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
                modifyevent(-2, 8, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
                lightscene();
                join(61);
                addethics(-6);
            } else {
                talk(61, "你的隊伍已滿，我無法加入．", 61, 0);
            }
        } else {
            talk(61, "不行，不行，我們同伴中沒有女的我會受不了，等你找到女的再說．", 61, 0);
        }
    } else {
        talk(0, "不行，我還是想當個大俠，不肖與你這個人為伍．", 0, 1);
        talk(61, "真是可惜，本來還想跟你研究研究”床上功夫”呢．", 61, 0);
    }
} else {
    dead();
}
