if (UseItem(180)) {
    talk(31, "啊！這是北宋范寬的真跡”谿山行旅圖”，你．．．你是從何處得來的？", 31, 0);
    talk(0, "這個你不必管．**我聽江湖上傳言，梅莊四莊主好酒，好畫，好劍，人稱三絕．那想必對我這幅畫定是”哈”死了！", 0, 1);
    talk(31, "你這小子，到底有什麼企圖？", 31, 0);
    talk(0, "”企圖”沒有，”行旅圖”倒是有一幅．", 0, 1);
    talk(31, "小子，少貧嘴，找死嘛？", 31, 0);
    talk(0, "就憑你？幫我搔癢還差不多．", 0, 1);
    talk(31, "啊！氣死我了！", 31, 0);
    if (TryBattle(43)) {
        lightscene();
        talk(31, "真是長江後浪推前浪，今日敗在你的手裡，我也沒話可說．", 31, 0);
        talk(0, "承讓了，四莊主．", 0, 1);
        talk(31, "小子，你等著，待我去請我三哥．", 31, 0);
        darkscene();
        modifyevent(-2, 3, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        setscenemap(-2, 1, 37, 42, 0);
        modifyevent(-2, 8, 1, 1, 253, -1, -1, 6048, 6048, 6048, -2, -2, -2);
        lightscene();
        addrepute(2);
    } else {
        dead();
    }
}
