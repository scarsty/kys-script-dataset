talk(105, "客倌想住宿嗎？本店有上好客房供應．一間２０兩．", 105, 0);
if (AskRest() == 1) {
    if (JudgeMoney(20)) {
        talk(0, "荒野之地多兇險，龍門地界只怕兵禍臨頭不遠．", 0, 1);
        darkscene();
        Rest();
        AddItemWithoutHint(174, -20);
        setsceneposition2(14, 14);
        SetRoleFace(3);
        lightscene();
    } else {
        talk(105, "走，走，走，沒錢就不要妨礙我做生意！", 105, 0);
    }
}
