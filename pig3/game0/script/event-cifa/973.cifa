talk(38, "好兄弟，你還好吧？我到現在還沒找到我媽媽及小黃呢？", 38, 0);
if (AskJoin()) {
    talk(0, "那不然我們再一起找好了，路上也有個照應．", 0, 1);
    if (!TeamIsFull()) {
        talk(38, "好啊．", 38, 0);
        darkscene();
        modifyevent(-2, 7, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        modifyevent(-2, 8, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(38);
    } else {
        talk(38, "你的隊伍已滿，我無法加入．", 38, 0);
    }
} else {
    talk(0, "這樣子啊！那你可得努力找哦．", 0, 1);
}
