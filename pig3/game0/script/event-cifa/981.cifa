talk(48, "你要幹嘛？", 48, 0);
if (AskJoin()) {
    talk(0, "鐵面，我需要你的幫忙，走吧．", 0, 1);
    if (!TeamIsFull()) {
        talk(48, "嗯．", 48, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(48);
    } else {
        talk(48, "你的隊伍已滿，我無法加入．", 48, 0);
    }
} else {
    talk(0, "沒事．", 0, 1);
}
