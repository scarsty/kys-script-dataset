if (UseItem(183)) {
    addethics(-14);
    AddItemWithoutHint(183, -1);
    talk(0, "喬峰，你看這是什麼？", 0, 1);
    talk(50, "是什麼？", 50, 0);
    talk(0, "你看了便知道．", 0, 1);
    darkscene();
    playmusic(9);
    lightscene();
    talk(50, "這．．這是真的嗎？", 50, 0);
    talk(0, "少林方丈親筆寫的，會是假的嗎！", 0, 1);
    talk(50, "我．．我．．我不是漢人．．．．我是契丹人．．．．", 50, 0);
    talk(0, "喬峰，你是契丹人，非我漢族人士，怎可擔任這丐幫幫主一職，保管”天龍八部”一書呢！", 0, 1);
    talk(50, "你要我怎麼做！", 50, 0);
    talk(0, "辭去丐幫幫主之位，交出”天龍八部”一書．", 0, 1);
    talk(50, "好！我今天就辭去這丐幫幫主之位，”天龍八部”一書你拿去吧．", 50, 0);
