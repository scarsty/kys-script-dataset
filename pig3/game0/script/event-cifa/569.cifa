talk(0, "徒兒，師父來看你了．", 0, 1);
talk(44, "．．．．", 44, 0);
talk(0, "叫師父啊．", 0, 1);
talk(44, "．．．師．．師父．", 44, 0);
if (AskJoin()) {
    talk(0, "徒兒，你就跟為師的走吧．", 0, 1);
    if (!TeamIsFull()) {
        talk(44, "是．", 44, 0);
        darkscene();
        modifyevent(-2, -2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        lightscene();
        join(44);
    } else {
        talk(44, "你的隊伍已滿，我無法加入．", 44, 0);
    }
} else {
    talk(0, "記得要乖哦！", 0, 1);
}
