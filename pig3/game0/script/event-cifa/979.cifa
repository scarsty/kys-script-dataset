talk(47, "愣小子，要幹嘛？", 47, 0);
if (AskJoin()) {
    talk(0, "阿紫姑娘，再加入我好嗎？", 0, 1);
    if (!TeamIsFull()) {
        talk(47, "你不怕我的話就走吧．", 47, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(47);
    } else {
        talk(47, "你的隊伍已滿，我無法加入．", 47, 0);
    }
} else {
    talk(0, "沒事．", 0, 1);
}
