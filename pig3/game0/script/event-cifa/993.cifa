talk(59, "公子近來無恙？", 59, 0);
if (AskJoin()) {
    talk(0, "還好，不過是否能再請龍姑娘出馬幫忙呢？", 0, 1);
    if (!TeamIsFull()) {
        talk(59, "好的．", 59, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(59);
    } else {
        talk(59, "你的隊伍已滿，我無法加入．", 59, 0);
    }
} else {
    talk(0, "托龍姑娘的福，一切還好．", 0, 1);
}
