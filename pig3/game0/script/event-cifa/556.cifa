talk(45, "少俠有什麼吩咐？", 45, 0);
if (AskJoin()) {
    if (!TeamIsFull()) {
        talk(0, "你的醫術很高明，就加入我的隊伍，日後也能幫我們治病療傷．", 0, 1);
        talk(45, "是．", 45, 0);
        darkscene();
        modifyevent(-2, -2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        lightscene();
        join(45);
    } else {
        talk(45, "你的隊伍已滿，我無法加入．", 45, 0);
    }
} else {
    talk(0, "沒什麼事，我路過這裡，進來看看你．", 0, 1);
}
