talk(2, "公子別來無恙？", 2, 0);
if (AskJoin()) {
    talk(0, "沒有靈姑娘這個大毒梟在，一路上都挺麻煩的，是否可請靈姑娘再出馬呢？", 0, 1);
    if (!TeamIsFull()) {
        talk(2, "那有什麼問題．", 2, 0);
        darkscene();
        modifyevent(-2, -2, 0, -1, -1, -1, -1, -1, -1, -1, -1, -2, -2);
        lightscene();
        join(2);
    } else {
        talk(2, "你的隊伍已滿，我無法加入．", 2, 0);
    }
} else {
    talk(0, "一切還好．", 0, 1);
}
