talk(54, "看到你的樣子，我的心也整個活躍了起來．", 54, 0);
if (AskJoin()) {
    talk(0, "不如這樣，袁兄何不暫時離開這小島，和在下一起到江湖上闖闖，再顯當年威風．", 0, 1);
    if (!TeamIsFull()) {
        talk(54, "好．離開武林這麼多年，也　不知變得怎麼樣了．袁某的功夫不知是否還管用．", 54, 0);
        talk(0, "我們走吧．", 0, 1);
        darkscene();
        modifyevent(-2, -2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        lightscene();
        join(54);
        addethics(5);
    } else {
        talk(54, "你的隊伍已滿，我無法加入．", 54, 0);
    }
}
