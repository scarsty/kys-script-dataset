talk(58, "少俠別來無恙，旅程一切還好吧．", 58, 0);
talk(0, "一切還好．", 0, 1);
if (AskJoin()) {
    talk(0, "不知楊兄是否有意與我為伴雲遊各地，一覽這五岳三川的風貌．", 0, 1);
    if (!TeamIsFull()) {
        talk(58, "好啊！或許旅途中會有龍兒的下落也說不定．", 58, 0);
        darkscene();
        modifyevent(-2, -2, 0, 0, -1, -1, -1, -1, -1, -1, -2, -2, -2);
        lightscene();
        join(58);
        addethics(3);
    } else {
        talk(58, "你的隊伍已滿，我無法加入．", 58, 0);
    }
}
